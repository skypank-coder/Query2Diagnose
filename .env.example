# Copy to .env (never committed) and fill in.
LLM_PROVIDER=groq            # groq | openai | anthropic | ollama | mock
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Hard stop for paid calls in one process (cached calls are free).
MAX_USD_PER_RUN=1.00

# Throttle (requests / tokens per minute); defaults suit Groq's free tier.
LLM_RPM=30
LLM_TPM=8000
