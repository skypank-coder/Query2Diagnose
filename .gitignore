# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets and local config
.env

# Caches and generated outputs (regenerated by make targets). Finished runs,
# tuning and the error analysis are kept: the paper's numbers come from them.
.cache/
results/*
!results/runs/
!results/tuning/
!results/latest.json
!results/error_analysis.md

# Web
web/node_modules/
web/dist/
# Draft paper and manuscript: local only, the repo is public (publishing the
# text before submission would trip the venue's similarity check).
web/public/paper.pdf
paper/query2diagnose_paper.*
paper/main.*
paper/references.bib
paper/*.zip
